OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
ENVIRONMENT=production
VALID_API_KEYS=devkey1,devkey2
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=20
DATABASE_URL=postgresql+asyncpg://gateway:gateway_dev_pw@postgres:5432/llm_gateway

# Load testing only (see benchmarks/README.md and DECISIONS.md) - leave as-is
# for normal use, the gateway uses the real OpenAI/Gemini providers.
LOAD_TEST_MODE=false
MOCK_PROVIDER_LATENCY_MS_MIN=200
MOCK_PROVIDER_LATENCY_MS_MAX=1500
MOCK_PROVIDER_FAIL=
