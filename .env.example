OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
ENVIRONMENT=development
VALID_API_KEYS=devkey1,devkey2
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=20
DATABASE_URL=postgresql+asyncpg://gateway:gateway_dev_pw@localhost:5432/llm_gateway

# Load testing only (see benchmarks/README.md and DECISIONS.md) - leave as-is
# for normal development, the gateway uses the real OpenAI/Gemini providers.
LOAD_TEST_MODE=false
MOCK_PROVIDER_LATENCY_MS_MIN=200
MOCK_PROVIDER_LATENCY_MS_MAX=1500
MOCK_PROVIDER_FAIL=

# Adaptive routing for model="auto" (see DECISIONS.md) - safe to leave at
# these defaults.
ROUTING_STATS_WINDOW_MINUTES=60
ROUTING_MIN_SAMPLES=20
ROUTING_ERROR_RATE_THRESHOLD=0.5
ROUTING_LATENCY_DEGRADATION_MULTIPLIER=2.0
